# Git-ignored by default (deepwork state directory)
# Sensitive credentials - NEVER commit these files
.env
.env.local
.env.development
.secrets
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
*.secret
.tokens.json
.credentials.json
.config.json
.jwt_secret

# Temporary files that might contain secrets
tmp_secrets.*
debug_*.*

# AIC-ADE local data (generated at runtime, NEVER commit these files)
data/
data/.jwt_secret
data/identity.json
data/tasks/
data/workspace/
backend/data/
storage/aic.db
AIC_DATA_DIR/*

# Venv and cache
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so

# GitHub token backup (if created for manual testing)
.github-token.backup
