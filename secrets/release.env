# AIC-ADE release signing env — source this before building/releasing.
#   source secrets/release.env
#
# Kept in secrets/ which is gitignored. NEVER commit this file.
# The PUBLIC key is safe to share; the PRIVATE key path points at the secret.

# Public verification key (raw 32-byte Ed25519, base64). Overrides the value
# baked into app/src/shared/updateSecurity.ts when set.
export AIC_UPDATE_PUBLIC_KEY="fXxYzXuiMkeMi4u7obc7RmJI07Whuvewlkl308ThH+o="

# Private signing key path, read by scripts/release.sh (step 5b).
export AIC_UPDATE_PRIVATE_KEY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/secrets/release_private_key.pem"
