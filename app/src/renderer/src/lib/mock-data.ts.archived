// ── Workers ─────────────────────────────────────────────────────

const workerDefs: Omit<WorkerDTO, "status" | "currentTask" | "cpu" | "mem" | "memPct" | "tasksCompleted">[] = [
  { id: "hermes", name: "Hermes", role: "Dispatcher", tier: "System Tier", department: "Leadership", personality: "Strict butler — routes tasks, never writes code.", phase: "Global", initial: "H" },
  { id: "rex", name: "Rex", role: "Governor", tier: "Sprinter Tier", department: "Leadership", personality: "Compliance gate — final reviewer.", phase: "Closeout", initial: "R" },
  { id: "aria", name: "Aria", role: "Product Manager", tier: "Thinker Tier", department: "Product", personality: "Empathetic translator — turns vague requests into user stories.", phase: "Investigate", initial: "A" },
  { id: "sage", name: "Sage", role: "Researcher", tier: "Thinker Tier", department: "Product", personality: "Evidence-driven analyst — finds facts, validates assumptions.", phase: "Investigate", initial: "S" },
  { id: "luna", name: "Luna", role: "Designer", tier: "Crafter Tier", department: "Product", personality: "User advocate — specifies layouts, interactions, visual consistency.", phase: "Implementation", initial: "L" },
  { id: "echo", name: "Echo", role: "Documentation Engineer", tier: "Sprinter Tier", department: "Product", personality: "Thorough writer — produces structured docs, reports, changelogs.", phase: "Closeout", initial: "E" },
  { id: "atlas", name: "Atlas", role: "Architect", tier: "Thinker Tier", department: "Engineering", personality: "Systems thinker — designs databases, APIs, tech stack.", phase: "Planning", initial: "A" },
  { id: "hugo", name: "Hugo", role: "Backend Engineer", tier: "Crafter Tier", department: "Engineering", personality: "Reliability nerd — APIs, database logic, security first.", phase: "Implementation", initial: "H" },
  { id: "leo", name: "Leo", role: "Frontend Engineer", tier: "Crafter Tier", department: "Engineering", personality: "UI craftsman — React, Vite, Tailwind.", phase: "Implementation", initial: "L" },
  { id: "eve", name: "Eve", role: "QA Engineer", tier: "Sprinter Tier", department: "Engineering", personality: "Perfectionist tester — writes tests, breaks things.", phase: "Verification", initial: "E" },
  { id: "pulse", name: "Pulse", role: "Performance Engineer", tier: "Sprinter Tier", department: "Engineering", personality: "Bottleneck hunter — profiling, load testing.", phase: "Verification", initial: "P" },
  { id: "nova", name: "Nova", role: "Data Engineer", tier: "Crafter Tier", department: "Platform", personality: "Data specialist — schemas, migrations, ETL.", phase: "Planning", initial: "N" },
  { id: "nexus", name: "Nexus", role: "Integration Engineer", tier: "Crafter Tier", department: "Platform", personality: "Connector — API integrations, service mesh.", phase: "Planning", initial: "N" },
  { id: "flint", name: "Flint", role: "Infrastructure Engineer", tier: "Crafter Tier", department: "Platform", personality: "Automation obsessed — Docker, CI/CD.", phase: "Planning", initial: "F" },
  { id: "sentinel", name: "Sentinel", role: "Security Engineer", tier: "Crafter Tier", department: "Platform", personality: "Threat modeler — vulnerability scanning, auth hardening.", phase: "Planning", initial: "S" },
];

const statusPool: WorkerStatus[] = ["idle", "thinking", "planning", "coding", "testing", "reviewing", "completed"];
const taskPool = ["Writing API routes", "Running test suite", "Designing schema", "Building components", "Reviewing PR", "Analyzing codebase", "Drafting changelog", "Scanning for CVEs", "Routing tasks", "Optimizing queries"];

export function getMockWorkers(): WorkerDTO[] {
  return workerDefs.map((w, i) => {
    const status = i < 3 ? "coding" as WorkerStatus : statusPool[i % statusPool.length];
    return {
      ...w,
      status,
      currentTask: status !== "idle" && status !== "offline" ? taskPool[i % taskPool.length] : undefined,
      currentObjective: status === "coding" ? "Implement feature according to spec" : undefined,
      model: w.tier === "Thinker Tier" ? "claude-sonnet-4" : w.tier === "Sprinter Tier" ? "gpt-4o-mini" : "gpt-4o",
      runtime: "Adaptive Runtime",
      cpu: status === "idle" ? 5 : 20 + Math.floor(Math.random() * 60),
      mem: `${100 + Math.floor(Math.random() * 300)}MB`,
      memPct: 20 + Math.floor(Math.random() * 60),
      tasksCompleted: Math.floor(Math.random() * 15),
      health: "healthy" as const,
    };
  });
}

// ── Timeline Events ─────────────────────────────────────────────

const eventDefs: Omit<TimelineEventDTO, "timestamp">[] = [
  { id: "e1", type: "mission", title: 'Mission "Implement Auth API" moved to Implementation', actor: "Sage", severity: "info" },
  { id: "e2", type: "worker", title: 'Worker Sage completed task "Code Review"', actor: "Sage", severity: "success" },
  { id: "e3", type: "system", title: 'Pipeline "Deploy Staging" started', actor: "Hermes", severity: "info" },
  { id: "e4", type: "approval", title: 'Approval requested: "Production Deployment"', description: "Requires action", actor: "Hermes", severity: "warning" },
  { id: "e5", type: "worker", title: "Worker Luna went idle", actor: "Luna", severity: "info" },
  { id: "e6", type: "mission", title: 'Mission "Optimize Database" verification passed', actor: "Echo", severity: "success" },
  { id: "e7", type: "worker", title: 'Worker Aria created new mission "Add Export Feature"', actor: "Aria", severity: "info" },
  { id: "e8", type: "runtime", title: "Adaptive runtime profile updated for claude-sonnet-4", actor: "System", severity: "info" },
  { id: "e9", type: "deployment", title: "Staging deployment completed successfully", actor: "Flint", severity: "success" },
  { id: "e10", type: "worker", title: "Worker Eve found 2 test failures", actor: "Eve", severity: "warning" },
];

export function getMockTimeline(): TimelineEventDTO[] {
  const now = Date.now();
  return eventDefs.map((e, i) => ({
    ...e,
    timestamp: new Date(now - i * 8 * 60000).toISOString(),
  }));
}

