# ============================================================================
# AIC-ADE Environment Configuration
# Copy to .env and fill in your values
# ============================================================================

# Directory where SQLite database and application data are stored
AIC_DATA_DIR=./data

# Secret key for session signing and cryptographic operations
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AIC_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_KEY

# Embedding provider for semantic search (local, openai)
AIC_EMBEDDING_PROVIDER=local

# OpenAI API key — only required if using openai embedding provider
OPENAI_API_KEY=

# Backend port (default: 8000, range: 8000-8099)
AIC_PORT=8000
