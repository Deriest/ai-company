{
  "name": "aic-ade",
  "version": "2.6.24",
  "private": true,
  "description": "AICompany ADE",
  "author": "TVD <tvd@local>",
  "homepage": "https://download.aicompany.biz.id",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deriest/ai-company.git"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && npm run build:electron && AIC_IDE_DEV=1 electron .\"",
    "start": "npm run build && electron .",
    "dev:vite": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-runtime.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "appImage": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Development",
    "maintainer": "TVD <tvd@local>",
    "executableName": "aic-ade",
    "extraResources": [
      {
        "from": "packaging/runtimes/python-linux",
        "to": "python-linux",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "AIC-ADE"
  },
  "build": {
    "appId": "com.aicompany.ade",
    "disableDefaultIgnoredFiles": true,
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack-chmod-sandbox.js",
    "productName": "AIC-ADE",
    "copyright": "Copyright © 2024 AI Company",
    "files": [
      "dist/**/*",
      "**/*.{html,json,js,css}",
      "src/**/*",
      "public/**/*",
      "package.json",
      "tsconfig*.json",
      "!**/.cache/**",
      "!**/node_modules/.cache/**",
      "!**/__tests__/**",
      "!**/*.test.ts",
      "!**/*.spec.ts",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "dist-electron/main/main.js",
      "version": "2.6.24"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/venv/**",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "packaging/runtimes/python-linux",
        "to": "python-linux",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "packaging/runtimes/python-win",
        "to": "python-win",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "artifactName": "AIC-ADE.SETUP.V${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "warningsAsErrors": false
    },
    "publish": {
      "provider": "github",
      "owner": "Deriest",
      "repo": "ai-company",
      "protocol": "https"
    }
  }
}
