{
  "name": "aic-ade",
  "version": "2.4.87",
  "private": true,
  "description": "AICompany ADE",
  "author": "TVD <tvd@local>",
  "homepage": "https://download.aicompany.biz.id",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && npm run build:electron && AIC_IDE_DEV=1 electron .\"",
    "start": "npm run build && electron .",
    "dev:vite": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && vite build",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-runtime.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "id.aicompany.ade",
    "productName": "AICompany ADE",
    "executableName": "AICompany ADE",
    "icon": "build/icon.png",
    "publish": {
      "provider": "generic",
      "url": ""
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "extraResources": [
        {
          "from": "packaging/runtimes/python-win",
          "to": "python-win",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "AIC-ADE-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "backend/**/*",
          "agents/**/*",
          "workers/**/*",
          "workflow/**/*",
          "conversation/**/*",
          "llm/**/*",
          "storage/**/*",
          "observability/**/*",
          "opencode/**/*",
          "auth/**/*",
          "runtime/**/*",
          "dispatcher/**/*",
          "policy/**/*",
          "events/**/*",
          "shared/**/*",
          "context/**/*",
          "autonomy/**/*",
          "verification/**/*",
          "discovery/**/*",
          "planning/**/*",
          "taskgraph/**/*",
          "delivery/**/*",
          "data/**/*",
          "requirements.txt",
          "pytest.ini"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "TVD <tvd@local>",
      "executableName": "aic-ade",
      "extraResources": [
        {
          "from": "packaging/runtimes/python-linux",
          "to": "python-linux",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AICompany ADE",
      "uninstallDisplayName": "AICompany ADE",
      "artifactName": "AIC-ADE-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "zip",
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "notarize": false
    }
  },
  "engines": {
    "node": ">=20"
  }
}
