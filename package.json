{
  "name": "aic-ade",
  "version": "2.6.34",
  "description": "AICompany ADE",
  "main": "app/dist-electron/main/main.js",
  "scripts": {
    "build:win": "electron-builder --win nsis --config app/package.json --publish never"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aicompany.ade",
    "productName": "AIC-ADE",
    "copyright": "Copyright \u00a9 2024 AI Company",
    "files": [
      "**/*.{html,json,js,css}",
      "src/**/*",
      "public/**/*",
      "package.json",
      "tsconfig*.json",
      "!**/.cache/**",
      "!**/node_modules/.cache/**",
      "!**/__tests__/**",
      "!**/*.test.ts",
      "!**/*.spec.ts",
      "!**/*.map",
      "!**/dist/**"
    ],
    "extraMetadata": {
      "version": "2.6.34"
    },
    "extraResources": [
      {
        "from": "packaging/runtimes/python-linux",
        "to": "python-linux",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "Deriest",
      "repo": "ai-company",
      "protocol": "https"
    }
  }
}
