# AIC Platform — Environment Configuration

# Core
APP_NAME=AIC Platform
VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/aic.db
DB_ECHO=false

# Auth — CHANGE THIS IN PRODUCTION
# H5: Use placeholder instead of hardcoded value
SECRET_KEY=<CHANGE_ME_IN_PRODUCTION_SECURE_RANDOM_STRING>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# OpenCode
OPENCODE_BIN=opencode
OPENCODE_TIMEOUT=600

# Runtime
WORKER_TIMEOUT=600
BARRIER_TIMEOUT=600
MAX_RECOVERY_ATTEMPTS=3
