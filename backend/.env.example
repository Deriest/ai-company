# Environment Variables for AIC Platform
# Copy this file to .env and customize

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-in-production-use-long-random-string

# LLM Provider Configuration
LLM_PROVIDER_URL=http://172.19.0.2:20128/v1
LLM_API_KEY=sk-4977b1282296a5d5-flq6o6-95297633

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/aic.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.2.10:8000

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/aic-platform.log

# Production Settings
PRODUCTION=true
DEBUG=false
